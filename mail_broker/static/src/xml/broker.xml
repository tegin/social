<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="mail_broker.broker">
        <div class="o_widget_Discuss" />
    </t>
    <t t-name="mail_broker.DiscussSidebarItem" owl="1">
        <div
            class="o_DiscussSidebarItem"
            t-att-class="{
                'o-active': thread and discuss.brokerChannel === thread,
                'o-unread': thread and thread.localMessageUnreadCounter > 0,
            }"
            t-on-click="_onClick"
            t-att-data-thread-local-id="thread.localId"
            t-att-data-thread-name="thread.name"
        >
            <div
                class=" o_DiscussSidebarItem_activeIndicator o_DiscussSidebarItem_item"
                t-att-class="{ 'o-item-active': discuss.brokerChannel === thread }"
            />
            <div
                class="o_DiscussSidebarItem_item o_DiscussSidebarItem_name"
                t-att-class="{ 'o-item-unread': thread.localMessageUnreadCounter > 0 }"
            >
                <t t-esc="thread.name" />
            </div>
            <div class="o-autogrow o_DiscussSidebarItem_item" />
        </div>
    </t>
